# ローカルHTTP API (npm run api) の設定例。
# このファイルを .env にコピーして値を入れてください (.env はGitに入りません)。

# engine=openai を使う場合に必要。engine=ardy だけなら不要
OPENAI_API_KEY=

# engine=claude を使う場合に必要 (sk-ant-...)
ANTHROPIC_API_KEY=

# --- 以下は任意 ---

# 既定のClaudeモデル (claude-fable-5-1 / claude-opus-5-5 / claude-sonnet-5-5 / claude-haiku-5-5)
# ANTHROPIC_MODEL=

# OpenAI互換プロバイダを使う場合のベースURL (OpenRouter / DeepSeek / Ollama 等)
# OPENAI_BASE_URL=

# 既定の生成モデル
# OPENAI_MODEL=

# ARDYローカルエンジンの接続先
# ARDY_URL=http://127.0.0.1:2337

# 待ち受けアドレス。127.0.0.1 以外にする場合は TEXT_TO_MOTION_API_TOKEN が必須
# HOST=127.0.0.1
# PORT=8787

# 全リクエストに Authorization: Bearer <token> を要求する
# TEXT_TO_MOTION_API_TOKEN=

# ブラウザ上のWebページから呼ぶ場合のみ設定 (許可するオリジン)
# TEXT_TO_MOTION_CORS_ORIGIN=

# --- Jev (TypeSafe AI) による意味・感情解析 (任意) ---
# 未設定なら従来どおり動作する。JEV_API_KEY があれば省略時も自動解析。
# リクエストの use_jev:false でその生成だけ解析を省略できる。

# JEV_API_KEY=

# サーバー全体で利用を止める場合のみ false を指定する
# JEV_ENABLED=false

# 既定モデル
# JEV_MODEL=jev-latest

# 日本語の入力はARDYエンジンの翻訳で英訳してからJevへ送る (Jevは英語が主な対象)。
# 0 を指定すると原文のまま送る。ARDYが起動していなければ自動で原文のまま送る
# JEV_TRANSLATE=0

# タイムアウト(ミリ秒)。超過時はJevをスキップして従来どおり生成する
# JEV_TIMEOUT_MS=4000

# 項目別の不確かさを示す診断用しきい値 (0〜1)。低信頼度でも生成は止めない。
# ARDYの追加スタイルは各項目0.55以上、顔は独立スコア×信頼度で重み付けする。
# JEV_CONFIDENCE_THRESHOLD=0.55
