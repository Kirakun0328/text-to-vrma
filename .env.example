# ローカルHTTP API (npm run api) の設定例。
# このファイルを .env にコピーして値を入れてください (.env はGitに入りません)。

# engine=openai を使う場合に必要。engine=ardy だけなら不要
OPENAI_API_KEY=

# engine=claude を使う場合に必要 (sk-ant-...)
ANTHROPIC_API_KEY=

# --- 以下は任意 ---

# 既定のClaudeモデル (claude-opus-5 / claude-sonnet-5 / claude-haiku-4-5)
# ANTHROPIC_MODEL=

# OpenAI互換プロバイダを使う場合のベースURL (OpenRouter / DeepSeek / Ollama 等)
# OPENAI_BASE_URL=

# 既定の生成モデル
# OPENAI_MODEL=

# ARDYローカルエンジンの接続先
# ARDY_URL=http://127.0.0.1:2337

# 待ち受けアドレス。127.0.0.1 以外にする場合は TEXT_TO_MOTION_API_TOKEN が必須
# HOST=127.0.0.1
# PORT=8787

# 全リクエストに Authorization: Bearer <token> を要求する
# TEXT_TO_MOTION_API_TOKEN=

# ブラウザ上のWebページから呼ぶ場合のみ設定 (許可するオリジン)
# TEXT_TO_MOTION_CORS_ORIGIN=
